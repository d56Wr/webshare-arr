WS_USER=your-webshare-username
WS_PASS=your-webshare-password
API_KEY=random-string-shared-with-radarr-and-sonarr
# optional: lets the service switch Radarr/Sonarr to prefer Webshare while VIP is active, torrents otherwise
RADARR_URL=http://127.0.0.1:7878
RADARR_KEY=radarr-api-key
SONARR_URL=http://127.0.0.1:8989
SONARR_KEY=sonarr-api-key
